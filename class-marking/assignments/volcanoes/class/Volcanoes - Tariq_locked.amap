ypeDouble"},{"name":"rotation","alias":"rotation","type":"esriFieldTypeDouble"},{"name":"_style","alias":"_style","type":"esriFieldTypeString","length":40}],"drawingInfo":{"renderer":{"type":"uniqueValue","field1":"_style","uniqueValueInfos":[{"value":"#0079c1|12|0","label":"","symbol":{"type":"esriSMS","style":"esriSMSCircle","color":[0,121,193,255],"size":12,"angle":0,"outline":{"type":"esriSLS","style":"esriSLSSolid","color":[255,255,255,255],"width":1.1}}}]}}},"featureSet":{"geometryType":"esriGeometryPoint","features":[{"geometry":{"x":-16697923.618991036,"y":3503549.843504374,"spatialReference":{"wkid":102100,"latestWkid":3857}},"attributes":{"ObjectId":1,"uid":"t000025","kind":"point","title":"My answers (written)","description":"I could not place points on the map, so here are my answers. Mount St. Helens: subduction zone, last eruption 2008. Mount Fuji (Fujisan): subduction zone, 1708. Pinatubo: subduction zone, 2021. Eyjafjallajökull: rift zone, 2010. Kīlauea: intraplate hotspot, 2024. Pattern: four are on plate boundaries, and three of those are subduction zones around the Pacific. Kīlauea is in the middle of a plate.","imageUrl":"","color":"#0079c1","size":12,"rotation":0,"_style":"#0079c1|12|0"}}]},"nextObjectId":2,"popupInfo":{"title":"{title}","description":"{description}","fieldInfos":[{"fieldName":"title","label":"Title","visible":true},{"fieldName":"description","label":"Description","visible":true}],"popupElements":[{"type":"text","text":"{description}"}],"showAttachments":false}}]}}],"baseMap":{"baseMapLayers":[{"id":"World_Hillshade_6395","showLegend":true,"opacity":1,"title":"World Hillshade","url":"https://services.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer","visibility":true,"itemId":"1b243539f4514b6ba35e7d995890db1d","layerType":"ArcGISTiledMapServiceLayer","minScale":1950180,"maxScale":71},{"id":"NatGeoStyleBase_3729","showLegend":true,"opacity":1,"title":"National Geographic Style Base","url":"https://tiles.a